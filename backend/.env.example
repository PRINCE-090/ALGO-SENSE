PORT=3000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Optional LLM API Keys (defaults to smart heuristic reviewer if unset)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional Database URL (e.g. Neon, Supabase, Railway PostgreSQL; defaults to local resilient store if unset)
DATABASE_URL=postgresql://postgres:password@localhost:5432/dsa_tracker

# GitHub OAuth Device Flow (Client secret stays strictly on Express backend)
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
